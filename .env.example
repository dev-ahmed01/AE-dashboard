# Copy this file to .env and set your own strong values before running.
POSTGRES_PASSWORD=REPLACE_WITH_A_UNIQUE_DATABASE_PASSWORD
JWT_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
ADMIN_EMAIL=admin@your-own-domain.com
ADMIN_USERNAME=
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_12_PLUS_PASSWORD
WEB_PORT=8081
CORS_ORIGIN=http://localhost:8081

# Required for real student email verification (registration is disabled without SMTP)
PUBLIC_SITE_URL=https://accombyemlen.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SUPPORT_EMAIL=

# Private object storage for licensed accommodation photographs
MINIO_ROOT_USER=accom_media
MINIO_ROOT_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_STORAGE_PASSWORD

# LOCAL TESTING ONLY. These credentials must never be used on a deployed site.
APP_ENVIRONMENT=development
LOCAL_DEMO_MODE=1
DEMO_ADMIN_USERNAME=Admin
DEMO_ADMIN_PASSWORD=Admin@123
